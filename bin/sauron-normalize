#!/usr/bin/env python3
"""
sauron-normalize - deterministic dense-TSV normalizer for recon JSON-L.

Candidate #1 of the token-cutting roadmap. Converts the verbose JSON-L emitted by
httpx / subfinder / dnsx / naabu / nuclei into an ultra-dense TSV with a single
header row, stripping the repeated JSON key names that dominate raw payloads.
Runs BEFORE anything reaches Claude's context or a PAL model, so the saving is
free (0 tokens, 0 latency, deterministic - it cannot refuse or hallucinate).

Usage:
    sauron-normalize [FILE ...]          # files, or '-'/no-arg for stdin
    cat httpx.jsonl | sauron-normalize
    sauron-normalize httpx.jsonl nuclei.jsonl

Each input line is one JSON object; the tool is auto-detected per line from the
keys present, so mixed streams are fine. Lines that are not JSON are passed
through unchanged (so it is safe to pipe arbitrary tool output through it).

Design rule: NEVER drop a field that carries security signal. The schemas below
keep host/url/status/tech/CVE/severity/matched-at; only structural JSON noise and
purely cosmetic fields (timestamps, fonts, hashes nobody triages) are dropped.
Add fields to a schema rather than widening the net, to keep output dense.
"""
import sys, json

# Per-tool column order. First matching schema (by required keys) wins.
SCHEMAS = [
    # nuclei: findings are the highest-value signal
    ("nuclei", ["template-id"],
     ["severity", "template-id", "matched-at", "host", "info.name"]),
    # httpx: live-host fingerprint
    ("httpx", ["url", "status_code"],
     ["url", "status_code", "title", "webserver", "tech", "content_length", "host"]),
    # dnsx: resolution
    ("dnsx", ["host", "a"],
     ["host", "a", "aaaa", "cname"]),
    # naabu: open ports
    ("naabu", ["port"],
     ["host", "ip", "port"]),
    # subfinder / generic host list
    ("subfinder", ["host"],
     ["host", "source"]),
]


def dig(obj, dotted):
    """Fetch a possibly-nested key like 'info.name'; '' if absent."""
    cur = obj
    for part in dotted.split("."):
        if isinstance(cur, dict) and part in cur:
            cur = cur[part]
        else:
            return ""
    if isinstance(cur, list):
        return ",".join(str(x) for x in cur)
    return "" if cur is None else str(cur)


def pick_schema(obj):
    for name, required, cols in SCHEMAS:
        if all(dig(obj, k) != "" for k in required):
            return name, cols
    return None, None


def cell(v):
    # TSV-safe: no tabs/newlines inside a cell.
    return v.replace("\t", " ").replace("\r", " ").replace("\n", " ")


def main():
    args = [a for a in sys.argv[1:] if a != "-"]
    streams = [open(a, encoding="utf-8", errors="replace") for a in args] if args else [sys.stdin]
    printed_header = {}   # tool -> True once its header is emitted
    out = sys.stdout
    for stream in streams:
        for line in stream:
            line = line.rstrip("\n")
            if not line.strip():
                continue
            try:
                obj = json.loads(line)
            except (ValueError, TypeError):
                out.write(line + "\n")     # pass through non-JSON untouched
                continue
            if not isinstance(obj, dict):
                out.write(line + "\n")
                continue
            tool, cols = pick_schema(obj)
            if not tool:
                out.write(line + "\n")     # unknown schema: don't lose data
                continue
            if tool not in printed_header:
                out.write("# {}\t{}\n".format(tool, "\t".join(cols)))
                printed_header[tool] = True
            out.write("\t".join(cell(dig(obj, c)) for c in cols) + "\n")
    for s in streams:
        if s is not sys.stdin:
            s.close()


if __name__ == "__main__":
    main()
